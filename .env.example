OPENAI_API_KEY=
TRANSCRIPTION_STREAMING_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_WEB_CONTEXT_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
NEXT_PUBLIC_BASE_PATH=/chat
NEXT_PUBLIC_APP_URL=https://ultrassom.ai/chat
PORT=3040
NODE_ENV=production
AUTH_ENABLED=true
AUTH_USERNAME=
AUTH_PASSWORD=
JWT_SECRET=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_RPM=
RATE_LIMIT_STUDIO_RPM=
RATE_LIMIT_STUDIO_AUTOCOMPLETE_RPM=180
# Workspace Python do Studio: sem a senha, o modo servidor fica desligado.
STUDIO_WORKSPACE_PASSWORD=
STUDIO_RUN_TIMEOUT_MS=120000
RATE_LIMIT_STUDIO_WORKSPACE_UNLOCK_RPM=10
RATE_LIMIT_STUDIO_WORKSPACE_RUN_RPM=30
RATE_LIMIT_TRANSCRIBE_RPM=
RATE_LIMIT_LOGIN_RPM=
PULSE_RUNNER_TOKEN=
PULSE_RUN_MODEL=
PULSE_MAX_OUTPUT_TOKENS=25000
PULSE_REASONING_EFFORT=medium
PULSE_EXTRACT_MODEL=
PULSE_RUNNER_URL=
SOUNDCASE_DATA_DIR=/root/CHATGPT/data/soundcase
SOUNDCASE_WORKER_TOKEN=
SOUNDCASE_WORKER_URL=http://127.0.0.1:3040/chat/api/soundcase/worker/run-next
SOUNDCASE_TTS_CONCURRENCY=2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://ultrassom.ai/chat/api/integrations/google/auth/callback
GOOGLE_CALENDAR_DEFAULT_ID=primary
GOOGLE_CALENDAR_DEFAULT_TIME_ZONE=America/Sao_Paulo
GOOGLE_TOKEN_ENCRYPTION_KEY=
