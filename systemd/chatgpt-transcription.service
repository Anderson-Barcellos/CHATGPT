[Unit]
Description=Gaúcho Chat - ditado ao vivo autenticado
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/CHATGPT
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_BASE_PATH=/chat
Environment=TRANSCRIPTION_PORT=3041
EnvironmentFile=/root/CHATGPT/.env.production
ExecStart=/root/CHATGPT/node_modules/.bin/tsx scripts/transcription-server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
