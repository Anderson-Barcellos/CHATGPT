[Unit]
Description=Gaucho Chat SoundCase durable worker
Documentation=https://ultrassom.ai/chat/soundcase
After=chatgpt.service
Requires=chatgpt.service

[Service]
Type=oneshot
User=root
UMask=0077
NoNewPrivileges=true
WorkingDirectory=/root/CHATGPT
EnvironmentFile=/root/CHATGPT/.env.production
ExecStart=/bin/bash /root/CHATGPT/scripts/run-soundcase-worker.sh
StandardOutput=append:/var/log/chatgpt/soundcase.log
StandardError=append:/var/log/chatgpt/soundcase-error.log
TimeoutStartSec=3h
