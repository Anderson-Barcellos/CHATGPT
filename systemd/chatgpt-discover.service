[Unit]
Description=Gaucho Chat AI news curator
After=chatgpt.service
Requires=chatgpt.service

[Service]
Type=oneshot
User=root
UMask=0077
NoNewPrivileges=true
WorkingDirectory=/root/CHATGPT
EnvironmentFile=/etc/chatgpt/discover.env
ExecStart=/bin/bash /usr/local/libexec/chatgpt-discover-run-due.sh
StandardOutput=append:/var/log/chatgpt/discover.log
StandardError=append:/var/log/chatgpt/discover-error.log
TimeoutStartSec=3600
